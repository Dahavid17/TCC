# Pasta de imagens enviadas por usuários: nunca executar scripts e não listar arquivos
Options -Indexes
<FilesMatch "\.(php|phtml|phar|php[0-9]*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
